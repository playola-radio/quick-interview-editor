#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:mac)

def print_failed_tests_summary(output_dir)
  abs_dir = File.expand_path(output_dir)
  xcresult = Dir[File.join(abs_dir, '*.xcresult')].max_by { |f| File.mtime(f) }
  return unless xcresult

  unless system("command -v xcresultparser > /dev/null 2>&1")
    UI.important("xcresultparser not installed — skipping failure summary. Run: brew install xcresultparser")
    return
  end

  UI.header("Failed tests")
  begin
    sh("xcresultparser -o cli --failed-tests-only #{xcresult.shellescape}")
  rescue => e
    UI.important("xcresultparser failed to produce a summary: #{e.message}")
  end
end

platform :mac do
  desc "Runs the Swift Testing suite (QuickInterviewEditorTests)"
  lane :test do
    # Local dev signs with the Playola team (Automatic) so the app stays a
    # stable, TCC-friendly binary. CI runners have no signing certs, so disable
    # code signing there — the unit tests don't need a signed, distributable app.
    xcargs = "-allowProvisioningUpdates"
    xcargs += " CODE_SIGNING_ALLOWED=NO" if ENV['CI']

    test_error = nil
    begin
      scan(
        project: "QuickInterviewEditor.xcodeproj",
        scheme: "QuickInterviewEditor",
        destination: "platform=macOS",
        include_simulator_logs: false,
        parallel_testing: false,
        xcargs: xcargs,
        xcodebuild_formatter: "xcbeautify",
        output_directory: "./fastlane/test_output/xctest",
        result_bundle: true
      )
    rescue => e
      test_error = e
    end
    print_failed_tests_summary('./fastlane/test_output/xctest') if test_error
    raise test_error if test_error
  end

  desc "Run SwiftLint (strict — fails on warnings)"
  lane :lint_code do
    swiftlint(
      mode: :lint,
      strict: true,
      config_file: ".swiftlint.yml",
      executable: "swiftlint"
    )
  end

  desc "Check swift-format formatting (fails on issues)"
  lane :format_check do
    sh("cd .. && make format-check")
  end

  # Bump the version single-source (project.yml), regenerate the Xcode project, and
  # commit — so `release` starts from a clean tree with a fresh, never-reused
  # CFBundleVersion. Usage:
  #   bundle exec fastlane mac bump                 # increment the build integer only
  #   bundle exec fastlane mac bump version:1.1.0   # + set the marketing version
  desc "Bump MARKETING_VERSION / integer CURRENT_PROJECT_VERSION, regenerate, commit"
  lane :bump do |options|
    project_yml = File.expand_path("../project.yml", __dir__)
    text = File.read(project_yml)
    current_build = text[/CURRENT_PROJECT_VERSION:\s*"(\d+)"/, 1]
    UI.user_error!("CURRENT_PROJECT_VERSION (integer) not found in project.yml") unless current_build
    new_build = (current_build.to_i + 1).to_s
    text = text.sub(/CURRENT_PROJECT_VERSION:\s*"\d+"/, %(CURRENT_PROJECT_VERSION: "#{new_build}"))

    if (new_marketing = options[:version])
      UI.user_error!("version must be semver X.Y.Z") unless new_marketing =~ /\A\d+\.\d+\.\d+\z/
      text = text.sub(/MARKETING_VERSION:\s*"[^"]*"/, %(MARKETING_VERSION: "#{new_marketing}"))
    end
    File.write(project_yml, text)
    marketing = text[/MARKETING_VERSION:\s*"([^"]*)"/, 1]

    sh("cd .. && xcodegen generate")
    sh("cd .. && git add project.yml QuickInterviewEditor.xcodeproj")
    sh(%(cd .. && git commit -m "build: bump to #{marketing} (#{new_build})"))
    UI.success("Bumped to #{marketing} (#{new_build}). Next: bundle exec fastlane mac release")
  end

  # LOCAL release (Decision 3): the multi-GB Apple-Silicon engine freeze makes this
  # impractical on hosted CI. Requires NOTARY_PROFILE + AWS write access. `packaging/`
  # lives at the REPO ROOT — two levels up from the fastlane dir (`sh` runs from
  # QuickInterviewEditor/fastlane), hence `cd ../..`.
  desc "Build, sign, notarize, DMG, sign appcast, upload to S3 (LOCAL release)"
  lane :release do
    ensure_git_status_clean
    UI.user_error!("set NOTARY_PROFILE (notarytool keychain profile)") if ENV["NOTARY_PROFILE"].to_s.empty?
    bucket  = ENV.fetch("RELEASE_S3_BUCKET", "playola-static")
    prefix  = ENV.fetch("RELEASE_S3_PREFIX", "downloads/QuickInterviewEditor")
    host    = ENV.fetch("RELEASE_DOWNLOAD_HOST", "https://playola-static.s3.amazonaws.com")
    profile = ENV.fetch("AWS_PROFILE", "default")

    # These env values are interpolated into shell commands below. Fail closed on
    # anything outside a safe charset rather than shell-escaping every call site — a
    # release lane shouldn't run surprising shell from a malformed profile/prefix.
    { "RELEASE_S3_BUCKET" => bucket, "RELEASE_S3_PREFIX" => prefix, "AWS_PROFILE" => profile }.each do |k, v|
      UI.user_error!("#{k} has unexpected characters: #{v.inspect}") unless v.match?(%r{\A[A-Za-z0-9._/-]+\z})
    end
    # Strict URL charset (not just an https: prefix): `host` is interpolated into
    # single-quoted `sh` commands below via `url`, so a value like
    # `https://h'; rm -rf ~ #` would break out of the quotes. Allow only
    # scheme://host[:port][/path] over a safe charset — no quotes, spaces, or shell
    # metacharacters — same fail-closed posture as the bucket/prefix/profile checks.
    unless host.match?(%r{\Ahttps://[A-Za-z0-9.-]+(?::\d+)?(?:/[A-Za-z0-9._/-]*)?\z})
      UI.user_error!("RELEASE_DOWNLOAD_HOST must be a plain https URL with no shell metacharacters: #{host.inspect}")
    end

    sh("cd ../.. && packaging/package-engine.sh")
    sh("cd ../.. && packaging/package-cut-suggester.sh")
    sh("cd ../.. && packaging/build-app.sh")
    sh("cd ../.. && packaging/sign-app.sh packaging/dist/QuickInterviewEditor.app")
    sh("cd ../.. && packaging/notarize-app.sh packaging/dist/QuickInterviewEditor.app")
    sh("cd ../.. && packaging/make-dmg.sh")

    plist = "packaging/dist/QuickInterviewEditor.app/Contents/Info.plist"
    short = sh("cd ../.. && /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' #{plist}").strip
    build = sh("cd ../.. && /usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' #{plist}").strip
    name = "QuickInterviewEditor-#{short}-#{build}.dmg"     # matches make-dmg.sh
    dmg  = "packaging/dist/#{name}"
    url  = "#{host}/#{prefix}/#{name}"

    # sign_update is extracted by xcodebuild into the release build's SourcePackages
    # (build-app.sh pins -derivedDataPath to packaging/build/app), so the path is
    # deterministic — no fragile ~/Library DerivedData search that could match a
    # stale/zero copy.
    sign_update = "packaging/build/app/SourcePackages/artifacts/sparkle/Sparkle/bin/sign_update"
    sh("cd ../.. && test -x '#{sign_update}' || { echo 'sign_update missing at #{sign_update} (build-app.sh must run first)' >&2; exit 1; }")

    # Pull the LIVE appcast down first so every prior <item> is preserved (rollback
    # depends on old entries staying in the feed). Fail CLOSED: use head-object so a
    # confirmed 404 (missing object) is the ONLY path that starts a fresh one-item
    # feed. Auth/network/other errors must abort — otherwise a transient S3 error on
    # a real release would regenerate a one-item feed and overwrite live history.
    sh(<<~SH)
      cd ../.. && set -euo pipefail
      key="#{prefix}/appcast.xml"
      if err="$(aws --profile #{profile} s3api head-object --bucket '#{bucket}' --key "$key" 2>&1 >/dev/null)"; then
        aws --profile #{profile} s3 cp "s3://#{bucket}/$key" packaging/dist/appcast.xml   # exists → must succeed
        echo "fetched existing appcast"
      elif printf '%s' "$err" | grep -qiE 'Not Found|404'; then
        # Remote is genuinely absent → start a FRESH feed. packaging/dist is
        # persistent + gitignored, so a leftover appcast.xml from a prior
        # staging/prod run must be cleared, or appcast.rb would append stale
        # entries (wrong URLs) and upload them under this prefix.
        rm -f packaging/dist/appcast.xml
        echo "no existing appcast — first release (cleared any stale local copy)"
      else
        echo "error: cannot read existing appcast (not a confirmed 404), aborting:" >&2
        printf '%s\\n' "$err" >&2; exit 1
      fi
    SH

    sh("cd ../.. && ruby packaging/appcast.rb '#{dmg}' '#{url}' '#{sign_update}'")

    # Keep old DMGs (no --delete). Upload the DMG, then the appended appcast last.
    sh("cd ../.. && aws --profile #{profile} s3 cp '#{dmg}' 's3://#{bucket}/#{prefix}/'")

    # Stable website-download alias. The website links to a FIXED url so the <a href>
    # never goes stale; Sparkle keeps using the versioned enclosure in the appcast.
    # Server-side S3->S3 copy of the DMG just uploaded — no multi-GB re-upload from
    # here. no-cache so a click always fetches the newest release (not a cached old
    # one); explicit disk-image content-type so browsers download rather than sniff.
    sh("cd ../.. && aws --profile #{profile} s3 cp 's3://#{bucket}/#{prefix}/#{name}' 's3://#{bucket}/#{prefix}/QuickInterviewEditor-latest.dmg' --content-type application/x-apple-diskimage --cache-control no-cache")

    sh("cd ../.. && aws --profile #{profile} s3 cp packaging/dist/appcast.xml 's3://#{bucket}/#{prefix}/appcast.xml' --content-type application/xml --cache-control no-cache")

    UI.success("Released #{short} (#{build}). Run the manual verification checklist (packaging/README.md) before announcing.")
  end
end
