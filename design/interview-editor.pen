                      "children": [
                        {
                          "type": "text",
                          "id": "lVxci",
                          "name": "Paragraph",
                          "fill": "#8F8F8F",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Well, thanks for having me. It's been a minute since I was back in Austin — I think the last time was the spring tour, and we played the Paramount two nights in a row.",
                          "lineHeight": 1.65,
                          "fontFamily": "$font",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "igUKE",
                          "name": "Clip Container — approved (green)",
                          "width": "fill_container",
                          "fill": "#5FB98F47",
                          "cornerRadius": 6,
                          "stroke": "#5FB98FD9",
                          "strokeWidth": 1,
                          "padding": [
                            0,
                            4
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "B8xPR",
                              "name": "Clip Words",
                              "fill": "#FFFFFF",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "So the first time I heard that song I was sitting in my dad's truck, and the radio just kind of stopped me cold. I didn't know who it was. I had to wait for the DJ to come back on and say it was Tom Petty, and that was it for me.",
                              "lineHeight": 1.65,
                              "fontFamily": "$font",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "gyvpc",
